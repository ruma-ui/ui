{
  "name": "@ruma-ui/source",
  "version": "0.1.0-dev.0",
  "description": "A modern, production-ready React UI component library built with TypeScript, Tailwind CSS, and Nx.",
  "license": "MIT",
  "author": "Ruma UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruma-ui/ui.git"
  },
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "build:ui": "nx build ui",
    "build:production": "cross-env NODE_ENV=production nx run-many -t build",
    "build:analyze": "cross-env NODE_ENV=analyze nx build ui",
    "dev": "nx run-many -t dev --parallel=3",
    "dev:ui": "nx dev ui",
    "dev:demo": "nx dev demo",
    "dev:website": "nx dev website",
    "test": "nx run-many -t test",
    "test:ui": "nx test ui",
    "test:coverage": "nx test ui --coverage",
    "test:watch": "nx test ui --watch",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "storybook": "nx storybook ui",
    "storybook:build": "nx build-storybook ui",
    "build-storybook": "nx build-storybook ui",
    "docs:api": "typedoc",
    "docs:build": "npm run docs:api && npm run storybook:build",
    "size": "size-limit",
    "size:analyze": "size-limit --why",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "release": "npm run build:production && npm run changeset:publish",
    "release:version": "npm run changeset:version && npm run build:production",
    "release:prerelease": "npm run build:production && npm run changeset:publish --tag",
    "release:semantic": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "clean": "nx reset && rm -rf dist coverage docs/api .nx/cache",
    "clean:all": "npm run clean && rm -rf node_modules pnpm-lock.yaml",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "precommit": "lint-staged",
    "postinstall": "nx reset"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^15.5.3",
    "@nx/eslint": "21.5.2",
    "@nx/eslint-plugin": "21.5.3",
    "@nx/jest": "21.5.2",
    "@nx/js": "21.5.2",
    "@nx/next": "21.5.2",
    "@nx/react": "21.5.2",
    "@nx/storybook": "21.5.2",
    "@nx/vite": "21.5.2",
    "@nx/web": "21.5.2",
    "@nx/workspace": "21.5.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@size-limit/preset-big-lib": "^11.2.0",
    "@storybook/addon-a11y": "^9.1.7",
    "@storybook/addon-docs": "9.1.7",
    "@storybook/react-vite": "9.1.7",
    "@swc-node/core": "^1.14.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.7.8",
    "@swc/core": "~1.13.5",
    "@swc/helpers": "~0.5.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "10.4.21",
    "babel-jest": "^30.1.2",
    "c8": "^10.1.3",
    "chromatic": "^13.2.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-storybook": "^9.1.7",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-environment-node": "^30.1.2",
    "jest-util": "^30.0.5",
    "jiti": "2.5.1",
    "jsdom": "~27.0.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^16.1.6",
    "nx": "21.5.2",
    "postcss": "8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^6.0.3",
    "semantic-release": "^24.2.9",
    "size-limit": "^11.2.0",
    "storybook": "9.1.7",
    "tailwindcss": "4.1.13",
    "ts-jest": "^29.4.4",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.8.1",
    "typedoc-plugin-missing-exports": "^4.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "verdaccio": "^6.1.6",
    "vite": "^7.1.6",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "clsx": "^2.1.1",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.9.1",
    "tailwind-merge": "^3.3.1"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ]
  }
}
