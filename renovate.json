{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    "group:monorepos",
    "group:recommended",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 4am on Monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "description": "Group React-related packages",
      "groupName": "React ecosystem",
      "matchPackageNames": ["/^react/", "/^@types/react/"]
    },
    {
      "description": "Group Nx packages",
      "groupName": "Nx monorepo",
      "matchPackageNames": ["/^@nx//", "/^nx$/"]
    },
    {
      "description": "Group testing packages",
      "groupName": "Testing tools",
      "matchPackageNames": ["/^@testing-library//", "/^jest/", "/^vitest/"]
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint ecosystem",
      "matchPackageNames": ["/^eslint/", "/^@eslint//"]
    },
    {
      "description": "Group TypeScript packages",
      "groupName": "TypeScript ecosystem",
      "matchPackageNames": ["/^typescript/", "/^@types//"]
    },
    {
      "description": "Group Storybook packages",
      "groupName": "Storybook ecosystem",
      "matchPackageNames": ["/^@storybook//"]
    },
    {
      "description": "Group semantic-release packages",
      "groupName": "semantic-release",
      "matchPackageNames": ["/^@semantic-release//"]
    },
    {
      "description": "Group changesets packages",
      "groupName": "changesets",
      "matchPackageNames": ["/^@changesets//"]
    },
    {
      "description": "Automerge patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require manual review for runtime dependencies",
      "matchDepTypes": ["dependencies"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"]
  }
}
