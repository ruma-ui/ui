{
  "name": "ruma-ui",
  "version": "0.1.0",
  "description": "CLI for adding ruma-ui components to your React project",
  "bin": {
    "ruma-ui": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
